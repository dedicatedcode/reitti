#!/usr/bin/env bash
#
# reitti-device-sync
#
# Pulls GPX/FIT files from USB-attached GPS devices (Garmin Edge 830 via MTP,
# Columbus P-1 Mark II via USB mass storage, or any mounted folder) and pushes
# them to a reitti instance using per-device API tokens.
#
# Files are only ever uploaded once: a local ledger keyed by sha256 content
# hash records every successful upload (see README.md).
#
# Requirements: bash 4+, curl, jq, sha256sum, stat, find, sort, flock

set -euo pipefail

VERSION="1.0.0"

DEFAULT_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/reitti-device-sync/config.conf"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/reitti-device-sync"

CONFIG_FILE="$DEFAULT_CONFIG"
ONLY_DEVICE=""
DRY_RUN=0
VERBOSE=0
CURL_TIMEOUT=600

log()   { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >&2; }
debug() { if (( VERBOSE )); then log "[debug] $*"; fi; }
warn()  { log "[warn]  $*"; }
die()   { log "[error] $*"; exit 1; }

usage() {
  cat <<EOF
reitti-device-sync $VERSION - upload GPX/FIT files from USB devices to reitti

Usage: reitti-device-sync [options]

Options:
  -c, --config <file>   Config file (default: $DEFAULT_CONFIG)
  -d, --device <name>   Only sync the given [section] from the config
  -n, --dry-run         Show what would be uploaded, change nothing
  -v, --verbose         Verbose logging
  -V, --version         Print version and exit
  -h, --help            This help
EOF
}

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

declare -A DEV_URL DEV_TOKEN DEV_ID DEV_SOURCES DEV_GLOB DEV_SKIP_RECENT DEV_MAX_AGE DEV_SETTLE
SECTIONS=()

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

check_numeric() { # <value> <key> <section>
  if [[ -n "$1" && ! "$1" =~ ^[0-9]+$ ]]; then
    die "Config error [$2]: '$3' must be a non-negative integer (got: '$1')"
  fi
}

load_config() {
  [[ -r "$CONFIG_FILE" ]] || die "Config file not readable: $CONFIG_FILE"

  local current="" line lineno=0 raw key value
  while IFS= read -r raw || [[ -n "$raw" ]]; do
    lineno=$((lineno+1))
    line="${raw%$'\r'}"
    line="$(trim "$line")"
    [[ -z "$line" || "$line" == \#* || "$line" == \;* ]] && continue

    if [[ "$line" =~ ^\[(.*)\]$ ]]; then
      current="$(trim "${BASH_REMATCH[1]}")"
      if [[ -z "$current" ]]; then
        die "Config error (line $lineno): empty section name"
      fi
      SECTIONS+=("$current")
      continue
    fi

    [[ "$line" == *=* ]] || die "Config error (line $lineno): expected key = value, got: $line"
    [[ -n "$current" ]] || die "Config error (line $lineno): key outside of a [section]"

    key="$(trim "${line%%=*}")"
    value="$(trim "${line#*=}")"

    case "$key" in
      url)                     DEV_URL["$current"]="$value" ;;
      token)                   DEV_TOKEN["$current"]="$value" ;;
      device_id)               DEV_ID["$current"]="$value" ;;
      # Repeatable: one glob pattern per 'source' line (may contain spaces)
      source)                  DEV_SOURCES["$current"]="${DEV_SOURCES[$current]:-}${value}"$'\n' ;;
      include_glob)            DEV_GLOB["$current"]="$value" ;;
      skip_modified_recent_min) DEV_SKIP_RECENT["$current"]="$value" ;;
      max_age_days)            DEV_MAX_AGE["$current"]="$value" ;;
      settle_seconds)          DEV_SETTLE["$current"]="$value" ;;
      *) warn "config line $lineno: unknown key '$key' in [$current], ignored" ;;
    esac
  done < "$CONFIG_FILE"

  (( ${#SECTIONS[@]} )) || die "No [device] sections found in $CONFIG_FILE"

  local s
  for s in "${SECTIONS[@]}"; do
    [[ -n "${DEV_URL[$s]:-}" ]]     || die "Device [$s] is missing 'url'"
    [[ -n "${DEV_TOKEN[$s]:-}" ]]   || die "Device [$s] is missing 'token'"
    [[ -n "${DEV_SOURCES[$s]:-}" ]] || die "Device [$s] is missing 'source'"
    DEV_GLOB["$s"]="${DEV_GLOB[$s]:-*}"
    DEV_SKIP_RECENT["$s"]="${DEV_SKIP_RECENT[$s]:-5}"
    DEV_MAX_AGE["$s"]="${DEV_MAX_AGE[$s]:-0}"
    DEV_SETTLE["$s"]="${DEV_SETTLE[$s]:-5}"
    check_numeric "${DEV_ID[$s]:-}"        "$s" "device_id"
    check_numeric "${DEV_SKIP_RECENT[$s]}" "$s" "skip_modified_recent_min"
    check_numeric "${DEV_MAX_AGE[$s]}"     "$s" "max_age_days"
    check_numeric "${DEV_SETTLE[$s]}"      "$s" "settle_seconds"
  done
}

check_deps() {
  local cmd missing=0
  for cmd in curl jq sha256sum stat find sort flock; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      log "[error] missing required command: $cmd"
      missing=1
    fi
  done
  if (( missing )); then
    die "please install the missing dependencies (see README.md)"
  fi
}

# ---------------------------------------------------------------------------
# Ledger (~/.local/state/reitti-device-sync/<device>.tsv)
# Columns: sha256 <TAB> size <TAB> mtime <TAB> path <TAB> uploaded_at <TAB> points
# ---------------------------------------------------------------------------

ledger_file() { printf '%s/%s.tsv' "$STATE_DIR" "$1"; }

ledger_has_meta() { # <device> <path> <size> <mtime>
  local f; f="$(ledger_file "$1")"
  [[ -f "$f" ]] || return 1
  awk -F'\t' -v p="$2" -v s="$3" -v m="$4" \
    '$2==s && $3==m && $4==p { found=1 } END { exit found ? 0 : 1 }' "$f"
}

ledger_has_hash() { # <device> <sha256>
  local f; f="$(ledger_file "$1")"
  [[ -f "$f" ]] || return 1
  awk -F'\t' -v h="$2" '$1==h { found=1 } END { exit found ? 0 : 1 }' "$f"
}

ledger_append() { # <device> <sha256> <size> <mtime> <path> <points>
  local f; f="$(ledger_file "$1")"
  shift
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$@" >> "$f"
}

# ---------------------------------------------------------------------------
# Upload
# ---------------------------------------------------------------------------

RESP_FILE="$(mktemp "${TMPDIR:-/tmp}/reitti-device-sync.XXXXXX")"
cleanup() { rm -f "$RESP_FILE"; }
trap cleanup EXIT

upload_file() { # <device> <path>; echoes points on success
  local dev="$1" path="$2"
  local -a args=(
    -sS -m "$CURL_TIMEOUT"
    -o "$RESP_FILE" -w '%{http_code}'
    -H "X-API-Token: ${DEV_TOKEN[$dev]}"
    -F "file=@$path"
  )
  [[ -n "${DEV_ID[$dev]:-}" ]] && args+=(-F "device=${DEV_ID[$dev]}")

  local code
  if ! code="$(curl "${args[@]}" "${DEV_URL[$dev]}")"; then
    warn "[$dev] curl failed while uploading $(basename "$path")"
    return 1
  fi

  if [[ "$code" != "200" ]]; then
    warn "[$dev] upload failed (HTTP $code): $(head -c 200 "$RESP_FILE" | tr '\n' ' ')"
    return 1
  fi

  local ok points
  ok="$(jq -r '.success' "$RESP_FILE" 2>/dev/null || echo "parse-error")"
  if [[ "$ok" == "true" ]]; then
    points="$(jq -r '.pointsScheduled // "?"' "$RESP_FILE" 2>/dev/null || echo "?")"
    printf '%s' "$points"
    return 0
  fi
  warn "[$dev] server rejected file: $(head -c 200 "$RESP_FILE" | tr '\n' ' ')"
  return 1
}

# ---------------------------------------------------------------------------
# Sync
# ---------------------------------------------------------------------------

resolve_dirs() { # <device> -> fills DIRS array
  DIRS=()
  local pattern d seen
  # Patterns are newline-separated (a single line = a single glob, which may
  # contain spaces). Splitting on newline while glob-expanding keeps paths
  # like "/run/user/1000/gvfs/.../Internal Storage/Garmin/Activities" intact.
  local IFS=$'\n'
  while IFS= read -r pattern; do
    [[ -z "$pattern" ]] && continue
    for d in $pattern; do
      [[ -d "$d" ]] || continue
      for seen in "${DIRS[@]:-}"; do
        [[ "$seen" == "$d" ]] && continue 2
      done
      DIRS+=("$d")
    done
  done <<< "${DEV_SOURCES[$1]}"
}

collect_candidates() { # <device> <dirs...> -> fills FILES array
  FILES=()
  local -a find_args=()
  local d
  for d in "${@:2}"; do
    find_args+=("$d")
  done
  find_args+=(-type f -iname "${DEV_GLOB[$1]}")
  local maxage="${DEV_MAX_AGE[$1]}"
  if [[ -n "$maxage" && "$maxage" -gt 0 ]]; then
    find_args+=(-mtime "-$maxage")
  fi
  while IFS= read -r -d '' f; do
    FILES+=("$f")
  done < <(find "${find_args[@]}" -print0 2>/dev/null || true)
}

sync_device() {
  local dev="$1"
  local skip_recent="${DEV_SKIP_RECENT[$dev]}"
  local uploaded=0 skipped=0 skipped_recent=0 failed=0

  resolve_dirs "$dev"
  if (( ${#DIRS[@]} == 0 )); then
    debug "[$dev] not connected (no source matched), skipping"
    return 0
  fi
  debug "[$dev] sources: ${DIRS[*]}"

  collect_candidates "$dev" "${DIRS[@]}"
  if (( ${#FILES[@]} == 0 )); then
    # gvfs/MTP mounts often need a while after appearing before they serve
    # directory listings; re-scan a couple of times before concluding that
    # the device genuinely has nothing new.
    local attempt
    for attempt in 1 2; do
      sleep "${DEV_SETTLE[$dev]}"
      collect_candidates "$dev" "${DIRS[@]}"
      if (( ${#FILES[@]} > 0 )); then
        debug "[$dev] files appeared after settling (${attempt}. retry)"
        break
      fi
    done
  fi

  debug "[$dev] ${#FILES[@]} candidate file(s)"

  local f now mtime age_min hash size points
  now="$(date +%s)"

  for f in "${FILES[@]:-}"; do
    [[ -n "$f" ]] || continue
    mtime="$(stat -c %Y "$f" 2>/dev/null)" || { warn "[$dev] cannot stat $f"; failed=$((failed+1)); continue; }
    size="$(stat -c %s "$f" 2>/dev/null)" || { warn "[$dev] cannot stat $f"; failed=$((failed+1)); continue; }

    age_min=$(( (now - mtime) / 60 ))
    if (( skip_recent > 0 && age_min < skip_recent )); then
      debug "[$dev] skipping (modified ${age_min}min ago, possibly still being written): $(basename "$f")"
      skipped_recent=$((skipped_recent+1))
      continue
    fi

    # Fast path: same path+size+mtime already uploaded
    if ledger_has_meta "$dev" "$f" "$size" "$mtime"; then
      debug "[$dev] already uploaded (path/size/mtime match): $(basename "$f")"
      skipped=$((skipped+1))
      continue
    fi

    hash="$(sha256sum "$f" 2>/dev/null | cut -d' ' -f1)" \
      || { warn "[$dev] cannot hash $f"; failed=$((failed+1)); continue; }

    # Content is the source of truth: catch renamed/rewritten copies too
    if ledger_has_hash "$dev" "$hash"; then
      debug "[$dev] already uploaded (content hash match): $(basename "$f")"
      skipped=$((skipped+1))
      continue
    fi

    if (( DRY_RUN )); then
      log "[$dev] would upload: $(basename "$f") (${size} bytes)"
      uploaded=$((uploaded+1))
      continue
    fi

    log "[$dev] uploading $(basename "$f") (${size} bytes)"
    if points="$(upload_file "$dev" "$f")"; then
      ledger_append "$dev" "$hash" "$size" "$mtime" "$f" "$points" "$(date '+%Y-%m-%d %H:%M:%S')"
      log "[$dev] uploaded $(basename "$f") -> ${points} point(s) queued"
      uploaded=$((uploaded+1))
    else
      warn "[$dev] upload failed, will retry on next run: $(basename "$f")"
      failed=$((failed+1))
    fi
  done

  if (( uploaded || skipped || skipped_recent || failed )); then
    log "[$dev] done: uploaded=$uploaded skipped(already-uploaded)=$skipped skipped(recent)=$skipped_recent failed=$failed"
  else
    log "[$dev] nothing to do"
  fi
  (( failed > 0 )) && return 1
  return 0
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

parse_args() {
  while (( $# )); do
    case "$1" in
      -c|--config)  CONFIG_FILE="$2"; shift 2 ;;
      -d|--device)  ONLY_DEVICE="$2"; shift 2 ;;
      -n|--dry-run) DRY_RUN=1; shift ;;
      -v|--verbose) VERBOSE=1; shift ;;
      -V|--version) printf '%s\n' "$VERSION"; exit 0 ;;
      -h|--help)    usage; exit 0 ;;
      *) die "unknown option: $1 (see --help)" ;;
    esac
  done
}

main() {
  parse_args "$@"
  check_deps
  load_config

  mkdir -p "$STATE_DIR"
  if (( ! DRY_RUN )); then
    # Serialize runs (path-unit trigger + manual invocation must not race)
    exec 9>"$STATE_DIR/.lock"
    if ! flock -n 9; then
      log "another reitti-device-sync instance is already running, exiting"
      exit 0
    fi
  fi

  local s found="" failed_any=0
  if [[ -n "$ONLY_DEVICE" ]]; then
    for s in "${SECTIONS[@]}"; do
      if [[ "$s" == "$ONLY_DEVICE" ]]; then
        found=1
        break
      fi
    done
    [[ -n "$found" ]] || die "no [${ONLY_DEVICE}] section found in $CONFIG_FILE"
    sync_device "$ONLY_DEVICE" || failed_any=1
  else
    for s in "${SECTIONS[@]}"; do
      sync_device "$s" || failed_any=1
    done
  fi
  exit "$failed_any"
}

main "$@"