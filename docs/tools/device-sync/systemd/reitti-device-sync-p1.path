[Unit]
Description=Trigger reitti sync when a USB mass storage volume (e.g. Columbus P-1) is mounted

[Path]
# The P-1 Mark II appears as a USB mass storage drive. udisks2 mounts by
# USERNAME (/media/daniel/...), so this unit uses %u (user name), unlike the
# Garmin unit where gvfs really uses the numeric uid (%U). If %u does not
# resolve on your system, replace it with your login name.
PathExistsGlob=/run/media/%u/*
PathExistsGlob=/media/%u/*
# Both path units trigger the same shared service (default would be a
# service named like this unit, which does not exist).
Unit=reitti-device-sync.service

[Install]
WantedBy=default.target
