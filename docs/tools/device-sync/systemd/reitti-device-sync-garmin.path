[Unit]
Description=Trigger reitti sync when a Garmin MTP device is mounted

[Path]
# The Edge 830 is an MTP device; desktop Linux (gvfs) mounts it here.
# If your systemd does not resolve %U, replace it with your numeric uid.
PathExistsGlob=/run/user/%U/gvfs/mtp:host=*
# Both path units trigger the same shared service (default would be a
# service named like this unit, which does not exist).
Unit=reitti-device-sync.service

[Install]
WantedBy=default.target
